# Copy to scripts/deploy.env (git-ignored) and fill in where to deploy.

# the server, reached over SSH
DEPLOY_HOST=user@example.com

# npm run deploy: the URL the app is served from, and its folder on the server
PROD_BASE_URL=https://example.com/crop-tease/
PROD_DIR=/var/www/crop-tease

# npm run deploy:beta
BETA_BASE_URL=https://example.com/crop-tease-beta/
BETA_DIR=/var/www/crop-tease-beta
