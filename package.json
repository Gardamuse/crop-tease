{
  "name": "crop-tease",
  "version": "1.2.0-beta.1",
  "private": true,
  "author": "Gardamuse",
  "license": "GPL-3.0-or-later",
  "description": "Crop and zoom your photos into comic pages.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "deploy": "./scripts/deploy.sh prod",
    "deploy:beta": "./scripts/deploy.sh beta",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --linux --win",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "vue": "^3.5.26",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.97.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vue-tsc": "^3.2.2"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.blushingdefeat.croptease",
    "productName": "Crop Tease",
    "artifactName": "crop-tease-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "electron/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "crop-tease-${version}-${os}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "crop-tease-${version}-${os}-${arch}-portable.${ext}"
    }
  },
  "desktopName": "crop-tease.desktop"
}
